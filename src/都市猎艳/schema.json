{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "世界": {
      "default": {},
      "type": "object",
      "properties": {
        "当前时间": {
          "default": "2026/06/01 14:00",
          "type": "string",
          "pattern": "^-?\\d+(?:\\.\\d+)?\\/-?\\d+(?:\\.\\d+)?\\/-?\\d+(?:\\.\\d+)? -?\\d+(?:\\.\\d+)?:-?\\d+(?:\\.\\d+)?$"
        },
        "当前区域": {
          "default": "待初始化",
          "type": "string"
        },
        "近期事件": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "主角": {
      "default": {},
      "type": "object",
      "properties": {
        "底牌等级": {
          "default": "深藏不露",
          "type": "string",
          "enum": [
            "深藏不露",
            "初露锋芒",
            "锋芒毕露",
            "惊世骇俗"
          ]
        },
        "威望值": {
          "default": 0,
          "type": "number"
        },
        "资产": {
          "default": 0,
          "type": "number"
        }
      }
    },
    "沈冰岚": {
      "$ref": "#/$defs/__schema0"
    },
    "沈玉瑶": {
      "$ref": "#/$defs/__schema0"
    },
    "顾晚晴": {
      "$ref": "#/$defs/__schema0"
    },
    "萧听雨": {
      "$ref": "#/$defs/__schema0"
    },
    "唐傲雪": {
      "$ref": "#/$defs/__schema0"
    },
    "苏晚吟": {
      "$ref": "#/$defs/__schema0"
    },
    "叶清桐": {
      "$ref": "#/$defs/__schema0"
    },
    "阮青蘅": {
      "$ref": "#/$defs/__schema0"
    },
    "秦望舒": {
      "$ref": "#/$defs/__schema0"
    }
  },
  "$defs": {
    "__schema0": {
      "default": {},
      "type": "object",
      "properties": {
        "好感度": {
          "default": 0,
          "type": "number"
        },
        "关系阶段": {
          "default": "初识",
          "type": "string",
          "enum": [
            "初识",
            "熟悉",
            "暧昧",
            "沦陷"
          ]
        },
        "当前穿着": {
          "default": "待初始化",
          "type": "string"
        },
        "心理活动": {
          "default": "待初始化",
          "type": "string"
        },
        "身体特征": {
          "default": {},
          "type": "object",
          "properties": {
            "胸部": {
              "default": "待初始化",
              "type": "string"
            },
            "腰臀": {
              "default": "待初始化",
              "type": "string"
            },
            "腿足": {
              "default": "待初始化",
              "type": "string"
            },
            "肌肤": {
              "default": "待初始化",
              "type": "string"
            }
          }
        }
      }
    }
  }
}